---
// Adapted from Jerry's Blog photo gallery under Apache-2.0; see THIRD_PARTY_NOTICES.md.
import type { GalleryPhoto } from '../lib/photo-wall';
interface Props { photos: GalleryPhoto[]; }
const { photos } = Astro.props;
const years = [...new Set(photos.map(photo => photo.year))].sort((a, b) => (Number(b) || -1) - (Number(a) || -1));
const datedYears = years.filter(year => /^\d{4}$/.test(year));
const pad = (n: number) => String(n).padStart(2, '0');
const data = JSON.stringify(photos.map(({ file, ...photo }) => photo)).replace(/</g, '\\u003c');
---
<section class="gallery-page shell" id="photo-gallery">
  <header class="page-intro">
    <p class="eyebrow mono"><span>PHOTOS</span><span>/</span><span>{photos.length} FRAMES</span>{datedYears.length > 0 && <><span>/</span><span>{datedYears.at(-1)} — {datedYears[0]}</span></>}</p>
    <h1>Photos <small>照片</small></h1>
    <p class="lede">一卷生活里的照片。读万卷书，行万里路，把有意义的时刻留在这里。</p>
  </header>

  <section class="memory-index" aria-label="光影坐标">
    <div class="memory-intro"><span class="memory-kicker mono">LITTLE MOMENTS, LONG STORIES</span><h2>光影坐标<span aria-hidden="true">↗</span></h2><p>{photos.length ? '点亮一个坐标，重访一段回忆。' : '把走过的路，留在光里。'}</p><span class="memory-count mono" id="index-count">{pad(photos.length)} 枚光影</span></div>
    <div class="memory-track" tabindex="0" aria-label="横向浏览照片坐标">
      <div class="memory-stops">
        <svg class="memory-route" viewBox="0 0 720 120" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M-10 64 C80 26 128 92 210 60 S330 26 420 60 S560 88 730 42" /></svg>
        {photos.length ? photos.map((photo, index) => <button type="button" class="memory-stop" style={`--c:${photo.color};--offset:${[12, 0, 16, 5][index % 4]}px`} data-open={photo.n} data-year={photo.year} aria-label={`打开光影坐标 ${pad(photo.n)}：${photo.title}`} title={photo.album}><span class="stop-number mono">{pad(photo.n)}</span><span class="stop-color" aria-hidden="true" /><span class="stop-title">{photo.title}</span><span class="stop-date mono">{photo.date?.slice(5).replace('-', '.') || '某个瞬间'}</span></button>) : [
          ['#96a59e', '走小路'], ['#c1a180', '看日落'], ['#91a4b4', '去远方'], ['#b7b2a4', '遇见人'], ['#a8aca1', '记平常'],
        ].map(([color, title], index) => <div class="memory-stop is-placeholder" style={`--c:${color};--offset:${[12, 0, 16, 5, 10][index]}px`} aria-hidden="true"><span class="stop-number mono">{pad(index + 1)}</span><span class="stop-color" /><span class="stop-title">{title}</span><span class="stop-date mono">TO BE CONTINUED</span></div>)}
      </div>
    </div>
  </section>

  <div class="year-filter" role="group" aria-label="按年份筛选" hidden={!photos.length}>
    <button type="button" class="year-button" data-filter="all" aria-pressed="true">全部 <span>{photos.length}</span></button>
    {years.map(year => <button type="button" class="year-button" data-filter={year} aria-pressed="false">{year} <span>{photos.filter(photo => photo.year === year).length}</span></button>)}
  </div>
  <div class="toolbar">
    <div class="views" role="group" aria-label="照片视图"><button type="button" class="vbtn" data-view="roll" aria-pressed="true">胶卷 Roll</button><button type="button" class="vbtn" data-view="table" aria-pressed="false">桌面 Table</button></div>
    <button type="button" class="vbtn shuffle" id="shuffle" hidden disabled={!photos.length}>重新摊开 ↻</button>
    <span class="mono hint" id="hint">点照片看大图 · ← → 切换</span>
  </div>
  <p id="gallery-status" class="gallery-status mono" aria-live="polite">全部 · {photos.length} 张照片</p>

  <section class:list={['roll', { 'is-empty': !photos.length }]} id="roll" aria-label="照片胶卷">
    {!photos.length && <div class="empty-state"><svg viewBox="0 0 64 64" width="58" height="58" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="9" y="17" width="46" height="34" rx="3"/><path d="m21 17 5-7h12l5 7"/><circle cx="32" cy="34" r="10"/><circle cx="47" cy="25" r="1.5"/></svg><h2>留一点空白，给下一次出发。</h2><p>照片还在路上，故事慢慢收集。</p><span class="mono">A PLACE FOR THE MOMENTS TO COME</span></div>}
    {photos.map(photo => <button type="button" class="frame" data-open={photo.n} data-n={photo.n} data-year={photo.year} style={`--c:${photo.color}`} aria-label={`查看第 ${photo.n} 张：${photo.album}`}>
      <img src={photo.thumb} alt={photo.alt} width={photo.width} height={photo.height} loading={photo.n <= 3 ? 'eager' : 'lazy'} decoding="async" />
      <span class="cap mono"><span class="fr">FR {pad(photo.n)}</span><span class="ct">{photo.title}</span>{photo.story && <span class="st">STORY</span>}</span>
    </button>)}
  </section>

  <section class="table" id="table" aria-label="照片桌面，可拖动照片" hidden>
    {!photos.length && <div class="table-empty mono">等待下一次快门 · WAITING FOR THE NEXT FRAME</div>}
    {photos.map(photo => <button type="button" class="print" data-open={photo.n} data-n={photo.n} data-year={photo.year} style={`--c:${photo.color};--r:${(photo.n % 11) - 5}deg`} aria-label={`拖动照片 ${photo.n}：${photo.title}，回车查看大图`}>
      <img data-src={photo.thumb} alt="" width={photo.width} height={photo.height} decoding="async" draggable="false" />
      <span class="pcap mono">{pad(photo.n)} / {photo.year}</span>
    </button>)}
  </section>
  <nav class="table-pagination mono" aria-label="桌面照片分页" id="table-pagination" hidden><button type="button" class="vbtn" id="table-previous">← 上一组</button><span id="table-page"></span><button type="button" class="vbtn" id="table-next">下一组 →</button></nav>

  <p class="gallery-note">每一张照片，都有自己的故事。</p>

  <dialog class="viewer" id="photo-viewer" aria-label="照片查看器">
    <div class="vtop mono"><span id="v-count"></span><span id="v-title"></span><button type="button" class="vclose" id="v-close" aria-label="关闭照片查看器" autofocus>Esc ✕</button></div>
    <div class="stage" id="v-stage"><button type="button" class="nav prev" id="v-prev" aria-label="上一张照片">←</button><img id="v-img" alt="" /><span id="v-loading" class="viewer-loading mono" role="status">照片载入中…</span><button type="button" class="nav next" id="v-next" aria-label="下一张照片">→</button></div>
    <div class="vstory" id="v-story" hidden></div>
    <div class="strip" id="v-strip" aria-label="照片缩略图导航">{photos.map(photo => <button type="button" class="sthumb" data-go={photo.n} data-year={photo.year} style={`--c:${photo.color}`} aria-label={`跳到第 ${photo.n} 张照片`}><img data-src={photo.thumb} alt="" decoding="async" /></button>)}</div>
  </dialog>
  <script type="application/json" id="photo-data" set:html={data} />
</section>
<script>
  import '../scripts/photo-gallery';
</script>

<style>

  [hidden] {
    display: none !important;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1rem;
  }
  .views {
    display: flex;
    gap: 0.4rem;
  }
  .vbtn {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
  }
  .vbtn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .shuffle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hint {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--muted);
  }
  /* Roll: masonry, full frames, no cropping */
  .roll {
    columns: 3 18rem;
    column-gap: 1rem;
  }
  /* Roll: Archival Matte Obsidian Contact Sheet Frames */
  .frame {
    display: block;
    width: 100%;
    margin: 0 0 1.15rem;
    padding: 8px 8px 2px;
    break-inside: avoid;
    border: 1.5px solid #020100;
    border-radius: 0;
    background: #1d1d1d;
    color: #f0f0ef;
    overflow: hidden;
    cursor: zoom-in;
    text-align: left;
    transition:
      transform 0.22s cubic-bezier(0.32, 0.72, 0, 1),
      border-color 0.2s ease;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--c);
    border: 1px solid #323230;
  }
  .frame:hover,
  .frame.lit,
  .frame:focus-visible {
    transform: translateY(-3px);
    border-color: var(--c-l6, #fa6d01);
  }
  .cap {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0.15rem 0.45rem;
    font-size: 0.68rem;
    color: #9a9a97;
  }
  .fr {
    color: #f0f0ef;
  }
  .ct {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .st {
    color: var(--c-l6, #fa6d01);
    border: 1px solid var(--c-l6, #fa6d01);
    border-radius: 2px;
    padding: 0 0.3rem;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  /* Table: prints on a dark lightbox */
  .table {
    position: relative;
    height: min(78svh, 760px);
    min-height: 520px;
    border-radius: 4px;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 40%, rgb(255 255 255 / 0.06), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 48px 48px,
      #101317;
    touch-action: pan-y;
  }
  .print {
    position: absolute;
    left: 40%;
    top: 30%;
    width: clamp(120px, 17vw, 210px);
    padding: 7px 7px 22px;
    border: 0;
    border-radius: 2px;
    background: #f7f7f4;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.4),
      0 10px 24px rgb(0 0 0 / 0.35);
    transform: rotate(var(--r));
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .print img {
    display: block;
    width: 100%;
    height: calc(100% - 0px);
    object-fit: cover;
    background: var(--c);
    pointer-events: none;
  }
  .print.lift {
    cursor: grabbing;
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.4),
      0 24px 48px rgb(0 0 0 / 0.5);
    transform: rotate(var(--r)) scale(1.04);
  }
  .print:focus-visible {
    outline: 2px solid #f08a4b;
    outline-offset: 3px;
  }
  .pcap {
    position: absolute;
    left: 8px;
    bottom: 4px;
    font-size: 10px;
    color: #66707c;
  }
  /* Viewer */
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 9 11 / 0.96);
    color: #e6e9ec;
    display: none;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
  }
  .viewer[open] {
    display: grid;
  }
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .vtop {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: max(0.75rem, env(safe-area-inset-top)) 1rem 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgb(230 233 236 / 0.75);
  }
  #v-count {
    color: #fff;
  }
  #v-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .vclose {
    font: inherit;
    color: #e6e9ec;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 2px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }
  .stage {
    position: relative;
    min-height: 0;
    touch-action: pan-y;
    overflow: hidden;
  }
  /* Ambient glow in the photo's dominant colour */
  .stage::before {
    content: '';
    position: absolute;
    inset: 10% 15%;
    background: radial-gradient(closest-side, var(--c, transparent), transparent);
    opacity: 0.35;
    filter: blur(60px);
    transition: background 0.4s ease;
    pointer-events: none;
  }
  #v-img {
    position: absolute;
    inset: 0.5rem 3.75rem;
    width: calc(100% - 7.5rem);
    height: calc(100% - 1rem);
    object-fit: contain;
    border-radius: 2px;
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 0.25s ease, transform 0.25s ease;
    user-select: none;
  }
  #v-img.in {
    opacity: 1;
    transform: none;
  }
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 2px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
  }
  .nav:hover {
    border-color: #f08a4b;
  }
  .prev {
    left: 0.75rem;
  }
  .next {
    right: 0.75rem;
  }
  .vstory {
    margin: 0 auto;
    max-width: 36rem;
    padding: 0.25rem 1rem 0;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgb(230 233 236 / 0.85);
  }
  .strip {
    display: flex;
    gap: 0.4rem;
    padding: 0.75rem 1rem max(0.75rem, env(safe-area-inset-bottom));
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sthumb {
    flex: none;
    width: 3.25rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 2px;
    background: var(--c);
    opacity: 0.5;
    cursor: pointer;
    overflow: hidden;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .sthumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sthumb:hover {
    opacity: 0.85;
  }
  .sthumb.on {
    opacity: 1;
    border-color: #f08a4b;
  }
  @media (max-width: 640px) {
    #v-img {
      inset: 0.5rem;
      width: calc(100% - 1rem);
    }
    .nav {
      display: none;
    }
    .hint {
      margin-left: 0;
      width: 100%;
    }
    .table {
      min-height: 460px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame,
    #v-img,
    .memory-stop {
      transition: none;
    }
  }

  .gallery-page { --font-mono: 'SFMono-Regular', Consolas, monospace; --gallery-accent: #d17b45; padding-block: 58px 75px; }
  .mono { font-family: var(--font-mono); }
  .page-intro { padding-bottom: 30px; border-bottom: 1px solid var(--line); margin-bottom: 32px; }
  .page-intro .eyebrow { gap: 16px; font-size: 10px; }
  .page-intro h1 { font-size: 48px; font-weight: 500; letter-spacing: -1.8px; line-height: 1.3; margin: 22px 0 18px; }
  .page-intro h1 small { margin-left: 15px; font-size: 20px; font-weight: 400; letter-spacing: 1px; color: var(--muted); vertical-align: middle; }
  .lede { line-height: 2; font-size: 14px; color: var(--muted); margin: 0; }
  .year-filter { display: flex; flex-wrap: wrap; gap: 7px; margin: 24px 0; }
  .year-button { background: transparent; border: 1px solid transparent; padding: 7px 11px; font-size: 11px; color: var(--muted); border-radius: 3px; }
  .year-button span { font-size: 9px; margin-left: 7px; opacity: .65; }
  .year-button[aria-pressed='true'] { background: var(--soft); border-color: var(--line); color: var(--ink); }
  .year-button:hover { color: var(--ink); }
  .toolbar { margin-bottom: 9px; }
  .vbtn { padding: 7px 12px; min-height: 32px; font-size: 10px; letter-spacing: .3px; }
  .gallery-status { color: var(--muted); font-size: 10px; margin: 0 0 17px; }
  .roll.is-empty { columns: auto; }
  .empty-state { min-height: 330px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; border: 1px dashed var(--line); padding: 45px 20px; color: var(--muted); }
  .empty-state h2 { font-family: var(--serif); color: var(--ink); font-size: 23px; font-weight: 500; margin: 25px 0 6px; letter-spacing: 1px; }
  .empty-state p { font-size: 12px; line-height: 2; }
  .empty-state > .mono { font-size: 8px; letter-spacing: 1.5px; margin-top: 20px; }
  .table-empty { position: absolute; inset: 0; display: grid; place-items: center; color: #9ba4b3; font-size: 10px; letter-spacing: 1px; padding: 25px; text-align: center; }
  .frame { appearance: none; }
  .frame:hover, .frame.lit, .frame:focus-visible { border-color: var(--gallery-accent); }
  .cap { padding-block: 10px 9px; }
  .st { color: var(--gallery-accent); border-color: var(--gallery-accent); }
  .table { height: min(78svh, 760px); min-height: 620px; }
  .print { width: clamp(125px, 16vw, 196px); }
  .print img { height: 145px; object-fit: cover; }
  .table-pagination { display: flex; justify-content: space-between; align-items: center; gap: 15px; padding-block: 18px; color: var(--muted); font-size: 11px; }
  .vbtn:disabled { opacity: .35; cursor: default; }
  .viewer { grid-template-rows: auto minmax(0, 1fr) auto auto; }
  .viewer-loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 11px; color: #b7bec8; pointer-events: none; }
  .vstory { max-height: 20dvh; width: min(100%, 760px); max-width: 760px; overflow-y: auto; text-align: left; padding: 4px 24px; font-size: 13px; }
  .vstory :global(p) { margin: 7px 0; }
  .vstory :global(a) { color: #b4c8ff; text-decoration: underline; }
  .vstory :global(.note) { background: #252a32; color: #e6e9ec; border-color: #434b57; font-size: 12px; padding: 5px 12px; margin: 8px 0; }
  .nav { z-index: 1; }
  :global(html.photo-viewer-open) { overflow: hidden; }
  @media (max-width: 760px) {
    .gallery-page { padding-block: 37px 45px; }
    .page-intro h1 { font-size: 40px; }
    .page-intro h1 small { font-size: 17px; margin-left: 10px; }
    .page-intro .eyebrow { gap: 10px; font-size: 8px; }
    .lede { font-size: 12px; }
    .empty-state h2 { font-size: 18px; letter-spacing: .2px; }
    .year-filter { gap: 3px; }
    .year-button { padding: 7px 9px; }
    .hint { font-size: 9px; }
    .roll { column-gap: 12px; columns: 2; }
    .frame { padding: 5px 5px 0; margin-bottom: 12px; }
    .cap { gap: 5px; padding: 8px 1px; font-size: 8px; }
    .st { font-size: 6px; padding: 0 2px; }
    .table { min-height: 530px; height: 65svh; }
    .print { width: 130px; }
    .print img { height: 120px; }
    .vtop { gap: 10px; font-size: 10px; }
    .vstory { max-height: 23dvh; padding-inline: 16px; font-size: 12px; }
    .table-pagination { font-size: 9px; }
    .table-pagination .vbtn { font-size: 9px; padding-inline: 9px; }
  }
  @media (max-width: 370px) { .roll { columns: 1; } }


  /* 光影坐标：沿曲线展开的照片索引，点击节点查看照片。 */
  .memory-index { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 30px; padding: 24px 27px; margin-bottom: 27px; border: 1px solid var(--line); border-radius: 7px; background: linear-gradient(120deg, var(--paper), var(--bg)); }
  .memory-intro { position: relative; min-width: 0; padding-top: 4px; }
  .memory-kicker { font-size: 7px; letter-spacing: 1px; color: var(--muted); }
  .memory-intro h2 { display: flex; align-items: center; gap: 17px; font: 500 23px var(--serif); letter-spacing: 2px; margin: 14px 0 11px; }
  .memory-intro h2 > span { font: 18px sans-serif; color: var(--accent); }
  .memory-intro p { font-size: 11px; color: var(--muted); line-height: 1.9; margin: 0; }
  .memory-count { display: inline-block; margin-top: 16px; font-size: 9px; color: var(--accent); letter-spacing: .5px; }
  .memory-track { min-width: 0; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
  .memory-stops { position: relative; display: flex; justify-content: space-between; width: max-content; min-width: 100%; gap: 22px; padding: 9px 10px 18px; }
  .memory-route { position: absolute; inset: 0; width: 100%; height: 100px; pointer-events: none; }
  .memory-route path { stroke: var(--line); stroke-width: 1.5; stroke-dasharray: 3 5; }
  .memory-stop { flex: 0 0 77px; position: relative; display: flex; align-items: center; flex-direction: column; gap: 0; padding: var(--offset, 0px) 0 0; border: 0; background: transparent; color: var(--ink); text-align: center; }
  .stop-number { font-size: 8px; letter-spacing: 1px; color: var(--muted); line-height: 1; margin-bottom: 14px; }
