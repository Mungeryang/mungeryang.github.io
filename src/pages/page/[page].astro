---
import Home from '../../components/Home.astro';
import { allPosts } from '../../lib/posts';
export async function getStaticPaths() { const all = await allPosts(); const sorted = [...all].sort((a, b) => b.data.sticky - a.data.sticky); return Array.from({ length: Math.ceil(all.length / 10) - 1 }, (_, i) => ({ params: { page: String(i + 2) }, props: { posts: sorted.slice((i + 1) * 10, (i + 2) * 10), all, page: i + 2, total: Math.ceil(all.length / 10) } })); }
---
<Home {...Astro.props} />
